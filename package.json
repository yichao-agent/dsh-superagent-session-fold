{
  "name": "dsh-superagent-session-fold",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Contain superagent worker sessions behind one sidebar status row and open the main orchestrator conversation on click.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs/screenshots"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yichao-agent/dsh-superagent-session-fold.git"
  },
  "homepage": "https://github.com/yichao-agent/dsh-superagent-session-fold#readme",
  "bugs": {
    "url": "https://github.com/yichao-agent/dsh-superagent-session-fold/issues"
  }
}
